# Copy to backend/.env and replace every placeholder. Do not commit backend/.env.

NODE_ENV=development
PORT=3000
# development attaches one fixed local user. The API refuses to boot this way when NODE_ENV=production.
AUTH_MODE=development
DEV_USER_ID=00000000-0000-4000-8000-000000000001
TRUST_PROXY=false

# Host-machine API (npm run start:dev). Compose overrides these for the api container.
DATABASE_URL=postgresql://aera:replace-with-a-local-password@localhost:5432/aera
REDIS_URL=redis://localhost:6379

POSTGRES_USER=aera
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=aera
POSTGRES_PORT=5432
REDIS_PORT=6379

GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=ArahBackend/1.0 (https://github.com/leakagelink/aera-mobile)
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org

CORS_ORIGINS=http://localhost:8081,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

# Server-only secrets. Leave these commented until you replace the placeholders.
# Generate an encryption key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AERA_SECRET_ENCRYPTION_KEY=
# ADMIN_JWT_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org
WEATHER_CACHE_TTL_SECONDS=600
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# AI_MAX_TOOL_ROUNDS=5
# AI_MAX_MESSAGE_CHARS=2000
# AI_MAX_CONTEXT_MESSAGES=8
# AI_RATE_LIMIT_PER_MINUTE=12
# TOMTOM_API_KEY=
# MAP_STYLE_URL=
# MAP_TILE_BASE_URL=
