# Public configuration only. Do not put secrets in EXPO_PUBLIC_ variables.
# Copy to .env.local for machine-specific overrides. .env.local is gitignored.

# Vector style used by MapLibre. OpenFreeMap does not require a token.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Nominatim place search. Identify the app and stay within public usage limits.
EXPO_PUBLIC_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
EXPO_PUBLIC_NOMINATIM_USER_AGENT=AeraMobile/1.0 (https://github.com/leakagelink/aera-mobile)

# OSRM driving routes. Replace the public demo server for production traffic.
EXPO_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org
