# Public configuration only. Do not put secrets in EXPO_PUBLIC_ variables.
# Copy to .env.local for machine-specific overrides. .env.local is gitignored.

# MapLibre style document. Swap this URL to move from the development tiles to a dedicated host.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Geocoding and place search. Nominatim is the development provider.
# EXPO_PUBLIC_NOMINATIM_BASE_URL is still accepted as a fallback.
EXPO_PUBLIC_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
EXPO_PUBLIC_GEOCODING_PROVIDER=nominatim
EXPO_PUBLIC_NOMINATIM_USER_AGENT=AeraMobile/1.0 (https://github.com/leakagelink/aera-mobile)

# Driving routes. OSRM is the development engine.
# EXPO_PUBLIC_OSRM_BASE_URL is still accepted as a fallback.
EXPO_PUBLIC_ROUTING_BASE_URL=https://router.project-osrm.org
EXPO_PUBLIC_ROUTING_PROVIDER=osrm

# Leave empty to keep using the direct development providers above.
# Set this when the Aera API should be the gateway. Never put secrets here.
# EXPO_PUBLIC_AERA_API_BASE_URL=http://localhost:3000
